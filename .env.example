# Neelam Industries — Smart Inventory Management System
# Local-first mode uses IndexedDB in the browser (default). No server required.

# Server-only (never prefix with VITE_ — credentials must not reach the browser)
MONGODB_URI=mongodb+srv://user:pass@cluster.example/
MONGODB_DB_NAME=neelam_inventory
PORT=3001

# Browser: API base URL (use /api in dev when Vite proxies to the Node server).
# When set, the app loads from MongoDB on startup (if data exists), skips auto demo seed,
# and debounces pushes to indexed MongoDB collections after local changes.
VITE_API_BASE_URL=/api
